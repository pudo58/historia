# Normalize line endings so Windows checkouts don't show every file as modified.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.wav binary
*.mp3 binary
*.safetensors binary
*.zip binary
*.rar binary
*.db binary
